    "def clean_pet_sematary(text: str) -> str:\n",
    "    text = remove_front_matter_pet(text)\n",
    "    text = basic_normalize(text)\n",
    "    return remove_back_matter(text)\n",
    "\n",
    "def clean_the_shining(text: str) -> str:\n",
    "    text = remove_front_matter_shining(text)\n",
    "    text = basic_normalize(text)\n",
    "    return remove_back_matter(text)\n",
    "\n",
    "pet_clean     = clean_pet_sematary(pet_raw)\n",
    "shining_clean = clean_the_shining(shining_raw)\n",
    "\n",
    "print(\"Pet Sematary cleaned length:\", len(pet_clean))\n",
    "print(\"The Shining cleaned length:\", len(shining_clean))"
