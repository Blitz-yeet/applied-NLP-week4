    "import re\n",
    "\n",
    "def basic_normalize(text: str) -> str:\n",
    "    text = text.replace('\\r\\n', '\\n').replace('\\r', '\\n')\n",
    "    lines = [ln.rstrip() for ln in text.split('\\n')]\n",
    "    text = \"\\n\".join(lines)\n",
    "    text = re.sub(r'\\n{3,}', '\\n\\n', text)\n",
    "    return text.strip()\n",
    "\n",
    "def remove_front_matter_pet(text: str) -> str:\n",
    "    \"\"\"Remove front matter before first real 'Chapter 1' line.\"\"\"\n",
    "    m = re.search(r\"^\\s*Chapter\\s+1\\s*$\", text, re.MULTILINE)\n",
    "    return text[m.start():] if m else text\n",
    "\n",
    "def remove_front_matter_shining(text: str) -> str:\n",
    "    \"\"\"Remove front matter before first numeric chapter heading like '1.' \"\"\"\n",
    "    m = re.search(r\"^\\s*1\\.\\s+\", text, re.MULTILINE)\n",
    "    return text[m.start():] if m else text\n",
    "\n",
    "def remove_back_matter(text: str) -> str:\n",
    "    \"\"\"Remove common end-matter patterns.\"\"\"\n",
    "    patterns = [\n",
    "        r\"(?i)introduction\\s*$\",\n",
    "        r\"(?i)epilogue\\s*$\",\n",
    "        r\"(?i)for\\s+[a-z][a-z\\s]+$\"  # For \"For Kirby McCauley\" etc.\n",
    "    ]\n",
    "    for pat in patterns:\n",
    "        text = re.sub(pat, \"\", text)\n",
    "    return text.strip()\n"
   ]
